VITE_API_BASE_URL="http://localhost:3000"

# Toggle fake auth ON for json-server (dev). Set to "false" when wiring the real C# backend.
VITE_USE_FAKE_AUTH="true"

# IAM
VITE_USERS_ENDPOINT_PATH="/users"
VITE_ORGANIZATIONS_ENDPOINT_PATH="/organizations"
VITE_SIGN_IN_ENDPOINT_PATH="/authentication/sign-in"
VITE_SIGN_UP_ENDPOINT_PATH="/authentication/sign-up"

# Subscription
VITE_PLANS_ENDPOINT_PATH="/plans"
VITE_SUBSCRIPTIONS_ENDPOINT_PATH="/subscriptions"

# Other contexts
VITE_STAKEHOLDER_ENDPOINT_PATH="/profiles"
VITE_ROUTE_ENDPOINT_PATH="/routes"
VITE_TRIP_ENDPOINT_PATH="/trips"
VITE_NOTIFICATION_ENDPOINT_PATH="/notifications"

# OpenRouteService  —  https://openrouteservice.org
VITE_ORS_BASE_URL="https://api.openrouteservice.org"
