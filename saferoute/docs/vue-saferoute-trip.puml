@startuml
skinparam monochrome false

package "trip.domain.model" {
  class Trip {
    - id: string
    - organizationId: string
    - routeId: string
    - driverId: string
    - tripState: string
    - startTime: string
    - endTime: string
    - attendances: Attendance[]
    - incidents: Incident[]
  }
  class Attendance {
    - id: string
    - tripId: string
    - childId: string
    - boardingState: string
    - boardedAt: string
  }
  class Incident {
    - id: string
    - tripId: string
    - description: string
    - reportedAt: string
  }
}

package "trip.application" {
  class TripStore {
    - currentTrip
    - attendances
    - incidents
    + startTrip(request): void
    + completeTrip(id): void
    + updateBoardingStatus(tripId, childId, state): void
    + reportIncident(tripId, description): void
    + loadAttendances(tripId): void
    + loadIncidents(tripId): void
  }
}

package "trip.infrastructure" {
  class TripApi {
    + startTrip(request)
    + getTripById(id)
    + completeTrip(id)
    + updateBoardingStatus(tripId, request)
    + getAttendancesByTrip(tripId)
    + reportIncident(tripId, request)
    + getIncidentsByTrip(tripId)
  }
  class TripAssembler {
    + toEntityFromResource(resource)
  }
  class AttendanceAssembler {
    + toEntityFromResource(resource)
    + toEntitiesFromResponse(response)
  }
  class IncidentAssembler {
    + toEntityFromResource(resource)
    + toEntitiesFromResponse(response)
  }
}

package "trip.presentation.views" {
  class ActiveTripView <<view>> {
    - trip: Trip
    - stops / progress
    - isScheduled / isCompleted
    + startSim(): void
    + pauseSim(): void
    + loadRoadRoute(): void
    + onSegmentArrival(wpIdx): void
  }
  class TripMonitoringView <<view>> {
    - trips: Trip[]
    + loadTrips(): void
  }
  class ParentTrackingView <<view>> {
    - busStatus / etaLabel / timeline
    - arrivalConfirmed: boolean
    + loadTrackingData(): void
    + advanceBus(): void
  }
  class AttendanceHistoryView <<view>> {
    - attendances: Attendance[]
  }
  class TripListView <<view>> {
    - visibleTrips: Trip[]
    + confirmDelete(trip): void
  }
  class TripFormView <<view>> {
    - form
    + saveTrip(): void
  }
}

